<plist version="1.0">
<dict>
	<key>CFBundleName</key><string>LaraMonster</string>
	<key>CFBundleDisplayName</key><string>LaraMonster</string>
	<key>CFBundleIdentifier</key><string>com.monstersgate.laramonster</string>
	<key>CFBundleExecutable</key><string>laramonster-app</string>
	<key>CFBundleIconFile</key><string>icon</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>__VERSION__</string>
	<key>CFBundleVersion</key><string>__VERSION__</string>
	<key>LSMinimumSystemVersion</key><string>11.0</string>
	<key>NSHighResolutionCapable</key><true/>
